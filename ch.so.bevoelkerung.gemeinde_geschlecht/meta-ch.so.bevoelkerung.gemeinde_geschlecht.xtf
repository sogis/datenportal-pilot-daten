      <DatasetSeries ili:tid="ch.so.bevoelkerung.gemeinde_geschlecht">
        <identifier>ch.so.bevoelkerung.gemeinde_geschlecht</identifier>
        <title>Wohnbevölkerung nach Gemeinde und Geschlecht (Schweizer/Ausländer)</title>
        <description>Ständige Wohnbevölkerung des Kantons Solothurn nach Gemeinde und Geschlecht, differenziert nach schweizerischer und ausländischer Staatsangehörigkeit (Männer/Frauen je Gruppe sowie Totale). Projektzweck: Kantonale Bevölkerungsstatistik als Grundlage für Planung, Berichterstattung und Verteilentscheide.</description>
        <accessLevel>open</accessLevel>
        <publicationStatus>published</publicationStatus>
        <creatorRef>ch.so.afin</creatorRef>
        <contactPoint>
          <base:ContactPoint>
            <base:name>Patrick Balles</base:name>
            <base:organizationUnit>Statistik</base:organizationUnit>
            <base:email>mailto:patrick.balles@fd.so.ch</base:email>
          </base:ContactPoint>
        </contactPoint>
        <themes>Bevoelkerung</themes>
        <keywords>Bevölkerung</keywords>
        <keywords>Wohnbevölkerung</keywords>
        <keywords>Bevölkerungsbestand</keywords>
        <keywords>Gemeinde</keywords>
        <keywords>Geschlecht</keywords>
        <keywords>Nationalität</keywords>
        <keywords>Schweizer</keywords>
        <keywords>Ausländer</keywords>
        <keywords>Solothurn</keywords>
        <accrualPeriodicity>annually</accrualPeriodicity>
