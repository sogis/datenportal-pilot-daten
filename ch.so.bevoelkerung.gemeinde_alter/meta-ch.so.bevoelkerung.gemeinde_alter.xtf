  <ili:datasection>
    <Metadata ili:bid="x1">
      <DatasetSeries ili:tid="ch.so.bevoelkerung.gemeinde_alter">
        <identifier>ch.so.bevoelkerung.gemeinde_alter</identifier>
        <title>Wohnbevölkerung nach Gemeinde, Geschlecht und Altersgruppen (inkl. Total Schweizer/Ausländer), Kanton Solothurn</title>
        <description>Ständige Wohnbevölkerung des Kantons Solothurn nach Gemeinde, mit Totalen nach Geschlecht (Männer/Frauen) und Staatsangehörigkeit (Schweizer/Ausländer) sowie nach Altersgruppen (0–19, 20–39, 40–64, 65–79, 80+). Ehemals «Eckdaten zur Wohnbevölkerung».
Projektzweck: Kantonale Bevölkerungsstatistik als Grundlage für Planung, Berichterstattung und Verteilentscheide.</description>
        <accessLevel>open</accessLevel>
        <publicationStatus>published</publicationStatus>
        <creatorRef>ch.so.afin</creatorRef>
        <contactPoint>
          <base:ContactPoint>
            <base:name>Patrick Balles</base:name>
            <base:organizationUnit>Statistik</base:organizationUnit>
            <base:email>mailto:patrick.balles@fd.so.ch</base:email>
          </base:ContactPoint>
        </contactPoint>
        <themes>Bevoelkerung</themes>
        <keywords>Bevölkerung</keywords>
        <keywords>Wohnbevölkerung</keywords>
        <keywords>Gemeinde</keywords>
        <keywords>Altersgruppen</keywords>
        <keywords>Altersstruktur</keywords>
        <keywords>Geschlecht</keywords>
        <keywords>Nationalität</keywords>
        <keywords>Solothurn</keywords>
        <accrualPeriodicity>annually</accrualPeriodicity>
        <modified>2026-08-20</modified>
        <temporalCoverage>
          <ClosedTemporalCoverage>
            <base:referenceDate>2025-12-31</base:referenceDate>
          </ClosedTemporalCoverage>
        </temporalCoverage>
        <surveyMethod>Vollerhebung (Registerauswertung) aus dem harmonisierten Einwohnerregister des Kantons Solothurn (Abbild der Gemeinderegister). Stichtagsbestand. Beobachtungseinheit: Person (AHV-Nr.), aggregiert auf Gemeinde.</surveyMethod>
        <attributes>
